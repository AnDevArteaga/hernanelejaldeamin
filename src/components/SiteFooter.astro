---
import Brand from './Brand.astro';
import { hrefOrPending, isConfigured, site } from '../config/site';

interface Props {
  homeHref?: string;
  shellClass?: string;
}

const { homeHref = '/', shellClass = 'shell' } = Astro.props;
const { links, brand, year } = site;

const legal = [
  { href: links.privacy, label: 'Política de Privacidad' },
  { href: links.terms, label: 'Términos y Condiciones' },
  { href: links.contact, label: 'Contacto' },
] as const;

const socials = [
  { href: links.facebook, label: 'Facebook', icon: 'facebook' },
  { href: links.instagram, label: 'Instagram', icon: 'instagram' },
  { href: links.youtube, label: 'YouTube', icon: 'youtube' },
  { href: links.twitter, label: 'X / Twitter', icon: 'twitter' },
] as const;
---

<footer class="site-footer">
  <div class:list={[shellClass, 'footer-main']}>
    <Brand href={homeHref} class="footer-brand" />

    <nav class="footer-links" aria-label="Enlaces legales">
      {
        legal.map((item, index) => (
          <>
            {index > 0 && <span>·</span>}
            <a
              href={hrefOrPending(item.href)}
              data-pending={!isConfigured(item.href) ? 'true' : undefined}
              title={!isConfigured(item.href) ? 'Pendiente de configurar' : undefined}
            >
              {item.label}
            </a>
          </>
        ))
      }
    </nav>

    <div class="socials" aria-label="Redes sociales">
      {
        socials.map((item) => (
          <a
            href={hrefOrPending(item.href)}
            aria-label={item.label}
            title={isConfigured(item.href) ? item.label : `${item.label} (pendiente de configurar)`}
            data-pending={!isConfigured(item.href) ? 'true' : undefined}
            target={isConfigured(item.href) ? '_blank' : undefined}
            rel={isConfigured(item.href) ? 'noopener noreferrer' : undefined}
          >
            {item.icon === 'facebook' && (
              <svg viewBox="0 0 24 24">
                <path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v7h4v-7h3l1-4h-4V9c0-.6.4-1 1-1Z" />
              </svg>
            )}
            {item.icon === 'instagram' && (
              <svg viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" />
              </svg>
            )}
            {item.icon === 'youtube' && (
              <svg viewBox="0 0 24 24">
                <path d="M21 8s0-3-3-3H6C3 5 3 8 3 8v8s0 3 3 3h12c3 0 3-3 3-3V8Z" />
                <path d="m10 9 5 3-5 3V9Z" />
              </svg>
            )}
            {item.icon === 'twitter' && (
              <svg viewBox="0 0 24 24">
                <path d="M4 4h4.2l4.1 5.8L16.8 4H20l-6.2 7.2L20.5 20H16.3l-4.5-6.3L7.2 20H4l6.6-7.6L4 4Z" />
              </svg>
            )}
          </a>
        ))
      }
    </div>
  </div>
  <div class:list={[shellClass, 'copyright']}>© {year} {brand}. Todos los derechos reservados.</div>
</footer>
