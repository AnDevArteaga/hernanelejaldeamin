---
import { site } from '../config/site';

interface Props {
  href?: string;
  class?: string;
}

const { href = '/', class: className = '' } = Astro.props;
---

<a class:list={['brand', className]} href={href} aria-label={`${site.brand} · ${site.tagline}`}>
  <span class="brand-symbol" aria-hidden="true">
    <svg viewBox="0 0 64 64" aria-hidden="true">
      <path
        d="M47.5 7.5C33 8.6 21.8 15.8 17 27c-3.4 8-2 16 3 23.1 1.1-13 7.2-23.5 18.7-32.2-8.5 9.6-13.2 19.7-14 30.4 11-2.2 20.3-8.7 25-18.8 3.2-7.2 3.5-14-2.2-22Z"
      ></path>
      <path
        d="M18 51.5c7.8-9.7 15-17.3 25.8-25"
        fill="none"
        stroke="currentColor"
        stroke-width="2.8"
        stroke-linecap="round"></path>
    </svg>
  </span>
  <span class="brand-copy">
    <strong>{site.brand}</strong>
    <small>{site.tagline}</small>
  </span>
</a>
