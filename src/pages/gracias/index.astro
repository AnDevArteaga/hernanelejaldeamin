---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { hrefOrPending, isConfigured, site } from '../../config/site';
import WistiaPlayer from '../../components/WistiaPlayer.astro';
import hernanEstudio from '../../assets/hernan-estudio.jpg';
import '../../styles/gracias.css';

const steps = [
  {
    title: '1. RECIBIRÁS UN CORREO',
    text: 'Con la confirmación y los detalles principales.',
    icon: 'mail',
  },
  {
    title: '2. TE ENVIAREMOS RECORDATORIOS',
    text: 'Por email y WhatsApp antes de la clase.',
    icon: 'bell',
  },
  {
    title: '3. EL DÍA DEL EVENTO',
    text: 'Te compartiremos el enlace de acceso.',
    icon: 'calendar',
  },
] as const;

const waConfigured = isConfigured(site.whatsapp.href);
---

<BaseLayout
  title={`Registro confirmado | ${site.brand}`}
  description={`Confirmación de registro a la clase online de ${site.brand}.`}
  shellClass="shell-narrow"
  noIndex={true}
>
  <main class="page">
    <div class="shell-narrow card">
      <section class="confirm">
        <div class="check" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="m5 12 4 4 10-10"></path></svg>
        </div>
        <h1>¡Tu registro está confirmado!</h1>
        <p>
          Gracias por dar este paso. Me alegra que hayas decidido ser parte de esta clase. Estás a un paso de quedar
          conectado con toda la información del evento.
        </p>
      </section>

      <section class="video-wrap">
        {
          site.wistia.gracias ? (
            <div class="video video--embed">
              <WistiaPlayer mediaId={site.wistia.gracias} title="Video de bienvenida" />
            </div>
          ) : (
            <div class="video">
              <Image
                src={hernanEstudio}
                alt={`${site.brand} en un estudio cálido`}
                widths={[640, 960, 1280]}
                sizes="(max-width: 980px) 100vw, 980px"
                loading="eager"
                fetchpriority="high"
              />
              <button class="play" type="button" data-video aria-label="Reproducir video">
                <svg viewBox="0 0 24 24">
                  <path d="m8.5 6.5 9 5.5-9 5.5z" />
                </svg>
              </button>
              <div class="video-note">
                Nos vemos pronto.<br />
                Hay un propósito para tu historia.
              </div>
            </div>
          )
        }
        <div class="duration">Duración sugerida del video: 1 minuto</div>
      </section>

      <section class="wa-box">
        <div class="wa-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"
            ><path
              d="M20.5 11.7a8.6 8.6 0 0 1-12.7 7.6L3 20.6l1.3-4.7a8.6 8.6 0 1 1 16.2-4.2Zm-12-4.1c-.2-.5-.4-.5-.7-.5h-.6c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 5 4.2 2.4 1 2.9.8 3.4.8.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.1-1.4-.1-.2-.3-.2-.6-.4l-1.8-.8c-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6l-.8-1.8Z"
            ></path></svg
          >
        </div>
        <h2>Ahora, únete a nuestro grupo de WhatsApp</h2>
        <p>
          Aquí te enviaré el enlace de la clase, recordatorios importantes y contenido adicional para que no te
          pierdas el evento.
        </p>
        <a
          class="btn-wa"
          href={hrefOrPending(site.whatsapp.href)}
          data-pending={!waConfigured ? 'true' : undefined}
          target={waConfigured ? '_blank' : undefined}
          rel={waConfigured ? 'noopener noreferrer' : undefined}
          title={!waConfigured ? 'Pendiente: configurar PUBLIC_WHATSAPP_GROUP_URL o PUBLIC_WHATSAPP_NUMBER' : undefined}
        >
          ENTRAR AL GRUPO DE WHATSAPP <span>→</span>
        </a>
        <p class="micro">Es importante que completes este paso para recibir los avisos del evento.</p>
      </section>

      <section class="steps">
        <h2>¿Qué sucede ahora?</h2>
        <div class="step-grid">
          {
            steps.map((step) => (
              <article class="step">
                <div class="step-icon" aria-hidden="true">
                  {step.icon === 'mail' && (
                    <svg viewBox="0 0 24 24">
                      <path d="M3 6.5h18v11H3zM4 7l8 6 8-6" />
                    </svg>
                  )}
                  {step.icon === 'bell' && (
                    <svg viewBox="0 0 24 24">
                      <path d="M18 8a6 6 0 1 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM9 20h6" />
                    </svg>
                  )}
                  {step.icon === 'calendar' && (
                    <svg viewBox="0 0 24 24">
                      <path d="M7 2v3M17 2v3M3.5 8.5h17M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
                    </svg>
                  )}
                </div>
                <strong>{step.title}</strong>
                <p>{step.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <blockquote class="quote">
        “Me alegra que estés aquí. Creo firmemente que esta clase puede ser un punto de reflexión e inicio en tu
        vida. Nos vemos muy pronto.”
        <span class="signature">{site.brand}</span>
      </blockquote>
    </div>
  </main>
</BaseLayout>

<script>
  import { initPendingLinks, initVideoPlaceholders } from '../../scripts/funnel';
  initPendingLinks();
  initVideoPlaceholders(document, 'Pendiente: configura PUBLIC_WISTIA_ID_GRACIAS con el ID de Wistia.');
</script>
