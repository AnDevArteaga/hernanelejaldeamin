# =============================================================================
# Funnel Hernán Elejalde Amin — variables públicas (Astro / Vercel)
# Copia este archivo a `.env` en local. En Vercel: Project → Settings → Environment Variables.
# NO pongas secretos de servidor aquí si en el futuro usas API keys privadas.
# Todas las PUBLIC_* son visibles en el HTML/JS del cliente.
# =============================================================================

# Dominio canónico de producción (sin barra final). Ej: https://tudominio.com
PUBLIC_SITE_URL=

# Opcional. Por defecto: Hernán Elejalde Amin
PUBLIC_SITE_NAME=

# Fecha/hora del webinar (ISO 8601). Ej: 2026-11-23T20:00:00-05:00
PUBLIC_EVENT_ISO=

# --- MasterTools Forms / Email Tool ---
# URL de action del formulario (la proporciona MasterTools). Vacío = flujo local a /gracias/
PUBLIC_MASTERTOOLS_FORM_ACTION=
# ID del formulario si MasterTools lo requiere (opcional)
PUBLIC_MASTERTOOLS_FORM_ID=

# --- WhatsApp (página Gracias) ---
# Opción A (recomendada por el copy actual): enlace al grupo
PUBLIC_WHATSAPP_GROUP_URL=
# Opción B: chat 1:1 (wa.me). Solo dígitos con código país, sin +. Ej: 573001234567
PUBLIC_WHATSAPP_NUMBER=
# Mensaje prellenado solo si usas Opción B
PUBLIC_WHATSAPP_MESSAGE=

# --- Wistia (solo el hashed ID del media, sin inventar) ---
PUBLIC_WISTIA_ID_CAPTURA=
PUBLIC_WISTIA_ID_GRACIAS=
PUBLIC_WISTIA_ID_WEBINAR=

# --- Oferta / checkout (CTA webinar) ---
PUBLIC_OFFER_URL=

# --- Legales ---
PUBLIC_URL_PRIVACY=
PUBLIC_URL_TERMS=
PUBLIC_URL_CONTACT=

# --- Redes ---
PUBLIC_URL_FACEBOOK=
PUBLIC_URL_INSTAGRAM=
PUBLIC_URL_YOUTUBE=
PUBLIC_URL_TWITTER=

# --- SEO (ruta absoluta o relativa bajo el dominio) ---
PUBLIC_OG_IMAGE=/assets/hernan-estudio.jpg
